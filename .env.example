# Copy to .env and adjust, or export these directly in your shell.
# .env itself is gitignored and must never be committed.

# Where the catalogue is stored. Defaults to books.txt next to this file.
LIBRARY_DATA_FILE=/path/to/your/books.txt

# How many days a book may be kept before it counts as overdue. Default: 14
LIBRARY_LOAN_DAYS=14
